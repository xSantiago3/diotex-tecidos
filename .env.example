# Application Configuration
APP_NAME=diotextecidos-agent-backend
APP_ENV=development

# Database
DATABASE_URL=sqlite:///./diotextecidos.db

# Google Cloud & AI
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_API_KEY=
DEFAULT_MODEL=gemini-2.5-flash

# WhatsApp / Meta
META_VERIFY_TOKEN=
META_APP_SECRET=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# E-commerce Integration (WooCommerce)
WOOCOMMERCE_BASE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Shipping Integration (Melhor Envio)
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_BASE_URL=https://www.melhorenvio.com.br
ME_SENDER_DOCUMENT=

# Marketplace Integration (Mercado Livre)
MERCADO_LIVRE_ACCESS_TOKEN=
MERCADO_LIVRE_USER_ID=
MERCADO_LIVRE_SITE_ID=MLB
MERCADO_LIVRE_BASE_URL=https://api.mercadolibre.com

# Payment Integration (Mercado Pago)
MERCADO_PAGO_ACCESS_TOKEN=

# Email Configuration
EMAIL_SENDER=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

# Admin & Notifications
ADMIN_ALLOWED_PHONES=+5511999999999
NOTIFICATION_PHONE=+5511999999999
ADMIN_OTP_ISSUER=DiotexTecidos

# Logistics
PREPARATION_EXTRA_DAYS=2
ORIGIN_ZIPCODE=01001-000

# Firestore (Optional)
FIRESTORE_ENABLED=false